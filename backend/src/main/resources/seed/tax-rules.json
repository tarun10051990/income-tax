    "category": "SLABS",
    "description": "Old regime individual slab rates",
    "effectiveFrom": "2024-04-01",
    "configuration": {
      "regime": "OLD",
      "slabs": [
        {
          "from": 0,
          "to": 250000,
          "rate": 0
        },
        {
          "from": 250000,
          "to": 500000,
          "rate": 0.05
        },
        {
          "from": 500000,
          "to": 1000000,
          "rate": 0.2
        },
        {
          "from": 1000000,
          "to": null,
          "rate": 0.3
        }
      ]
    }
  },
